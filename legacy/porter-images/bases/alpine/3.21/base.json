{
  "schemaVersion": "1",
  "name": "alpine",
  "version": "3.21",
  "arch": "x86_64",
  "description": "Alpine 3.21 minirootfs base: musl, OpenRC, serial console on ttyS0. Built per the Firecracker docs rootfs recipe (mke2fs -d).",
  "inputs": {
    "rootfsTar": "https://dl-cdn.alpinelinux.org/alpine/v3.21/releases/x86_64/alpine-minirootfs-3.21.2-x86_64.tar.gz",
    "kernel": "vmlinux-6.18.48 (official Firecracker microVM kernel)"
  },
  "outputs": {
    "rootfs": "rootfs.ext4",
    "kernel": "vmlinux"
  },
  "build": "sudo ./build.sh --rootfs-tar <path> --kernel <path> --out ."
}
