{
  "schemaVersion": "1",
  "name": "postgres",
  "title": "PostgreSQL",
  "description": "Advanced open-source relational database.",
  "category": "database",
  "type": "application",
  "official": true,
  "arch": ["x86_64"],
  "source": { "kind": "docker-hub", "reference": "docker.io/library/postgres" },
  "base": { "name": "ubuntu", "ref": "bases/ubuntu/24.04" },
  "defaults": {
    "cpu": 2,
    "ramMb": 2048,
    "diskGb": 10,
    "ports": [5432],
    "volumes": ["/var/lib/postgresql/data"],
    "health": "pg_isready -U porter"
  },
  "versions": [
    { "tag": "18", "status": "beta" },
    { "tag": "17", "status": "stable" }
  ]
}
