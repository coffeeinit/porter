{
  "schemaVersion": "1",
  "name": "redis",
  "title": "Redis",
  "description": "In-memory data store used as cache, message broker, and queue.",
  "category": "cache",
  "type": "application",
  "official": true,
  "arch": ["x86_64"],
  "source": { "kind": "docker-hub", "reference": "docker.io/library/redis" },
  "base": { "name": "alpine", "ref": "bases/alpine/3.20" },
  "defaults": {
    "cpu": 1,
    "ramMb": 1024,
    "diskGb": 2,
    "ports": [6379],
    "volumes": ["/data"],
    "health": "redis-cli ping | grep -q PONG"
  },
  "versions": [
    { "tag": "8-alpine", "status": "stable" }
  ]
}
