#!/bin/sh
# Test double for buildctl: records its arguments and "exports" a prepared OCI image (never builds anything).
echo "$*" >> "${SHIM_LOG:-/tmp/shim-buildctl.log}"
case "$*" in *"debug workers"*) echo "ID  PLATFORMS"; exit 0;; esac
case "$*" in *"build-arg:FAIL=1"*) echo "ERROR: failed to solve: process did not complete successfully" >&2; exit 1;; esac
dest=$(echo "$*" | sed -n 's/.*type=oci,dest=\([^ ]*\).*/\1/p')
cp "$SHIM_OCI_TAR" "$dest"
echo "#1 [internal] load build definition from Dockerfile"; echo "#2 [stage-1 2/2] COPY --from=builder /app/dist /usr/share/nginx/html"; echo "#9 exporting to oci image format"; echo "#9 DONE 0.2s"
