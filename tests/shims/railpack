#!/bin/sh
case "$1" in
  --version) echo "railpack version 0.43.0";;
  prepare)
    while [ $# -gt 0 ]; do case "$1" in --plan-out) P="$2"; shift;; --info-out) I="$2"; shift;; esac; shift; done
    mkdir -p "$(dirname "$P")"; echo '{"steps":[]}' > "$P"; echo '{"detectedProviders":["node"],"startCommand":"npm start"}' > "$I"; echo "Detected Node project";;
esac
