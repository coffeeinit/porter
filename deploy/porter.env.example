# Non-secret Porter settings only. The systemd units provide the database DSN
# and operator Bearer through LoadCredential; do not add secrets here.
# Admin and PostgreSQL credentials are raw root-owned files loaded only through
# systemd LoadCredential: /etc/porter/porter-admin-token and
# /etc/porter/porter-postgres-dsn. Never put them here or pass them in argv.
# The installer provisions local PostgreSQL on Ubuntu/Debian by default and
# creates a least-privilege porter role/database using peer auth.
# For external PostgreSQL, put the raw DSN in /etc/porter/porter-postgres-dsn;
# the installer then skips local PostgreSQL package/service/database setup.
PORTER_ADDR=127.0.0.1:8080

# Production requires API TLS. Configure these paths only when TLS and a public
# endpoint are verified. Do not expose the loopback HTTP default to the internet.
# PORTER_API_TLS_CERT=/etc/porter/tls/server.crt
# PORTER_API_TLS_KEY=/etc/porter/tls/server.key

# Development mode is for loopback development only; do not use publicly.
# PORTER_API_MODE=development
