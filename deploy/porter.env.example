# Production requires API TLS. Loopback HTTP and development mode are for
# local development only; do not expose this default to the public internet.
# Keep the API local until verified TLS and a public endpoint are configured.
PORTER_ADDR=127.0.0.1:8080
# Only non-secret settings belong in this file. The PostgreSQL DSN and admin
# Bearer token are supplied through systemd LoadCredential from
# /etc/porter/porter-postgres-dsn and /etc/porter/porter-admin-token. Never add
# either secret here, use PORTER_DB, or add an environment fallback for them.
# Configure these TLS paths only when verified TLS and a public endpoint are ready.
# PORTER_API_TLS_CERT=/etc/porter/tls/server.crt
# PORTER_API_TLS_KEY=/etc/porter/tls/server.key
# Development mode is for loopback development only; do not use publicly.
# PORTER_API_MODE=development
# By default, the installer provisions local PostgreSQL on Ubuntu/Debian,
# enables and starts it, and creates the least-privilege porter role/database.
# The local DSN uses PostgreSQL peer auth as the porter service account.
# Advanced mode: put an external raw DSN in porter-postgres-dsn; the installer
# then skips local PostgreSQL package, service, and role/database provisioning.
