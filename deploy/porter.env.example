# Non-secret Porter settings only. The systemd units provide the database DSN
# and operator Bearer through LoadCredential; do not add secrets here.
# Admin and PostgreSQL credentials are raw root-owned files loaded only through
# systemd LoadCredential: /etc/porter/porter-admin-token and
# /etc/porter/porter-postgres-dsn. Never add them to this environment file.
PORTER_ADDR=127.0.0.1:8080

# Production defaults require API TLS. Configure these paths and the listener
# before enabling remote access; do not switch a non-loopback listener to HTTP.
# PORTER_API_TLS_CERT=/etc/porter/tls/server.crt
# PORTER_API_TLS_KEY=/etc/porter/tls/server.key

# Development-only example for a loopback listener:
# PORTER_API_MODE=development
