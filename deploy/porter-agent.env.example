# Root-owned, non-secret host-agent configuration.
# The agent validates an existing state directory as-is; it will not chmod or chown it.
PORTER_AGENT_STATE_DIR=/var/lib/porter-agent
PORTER_AGENT_KERNEL=/var/lib/porter-agent/vmlinux
PORTER_AGENT_ROOTFS=/var/lib/porter-agent/rootfs.ext4

# Optional TLS paths supported by porter-agent join/run. Uncomment only when needed.
# PORTER_AGENT_SERVER_CA=/etc/porter/tls/server-ca.pem
# PORTER_AGENT_CLIENT_CERT=/etc/porter/tls/agent.crt
# PORTER_AGENT_CLIENT_KEY=/etc/porter/tls/agent.key
# Keep private-key bytes in a separate root-owned file with restrictive permissions.
# Never put certificate or private-key contents in this file.
#
# The current deploy/systemd/porter-agent.service does not load this file with
# EnvironmentFile; these settings are inactive until that unit integration is added.
# The installer copies this file only when /etc/porter/porter-agent.env is absent.
