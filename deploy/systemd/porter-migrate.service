[Unit]
Description=Apply Porter PostgreSQL schema migrations
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=porter
Group=porter
LoadCredential=porter-postgres-dsn:/etc/porter/porter-postgres-dsn
UnsetEnvironment=PORTER_POSTGRES_DSN PORTER_ADMIN_TOKEN
ExecStart=/usr/local/bin/porter-migrate apply
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
